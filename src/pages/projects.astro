---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { PROJECTS } from '../data/site';
const crumbs = [{ name: 'Projects' }];
---
<Base title="Mailbox Installation Projects | Postal Systems" description="Recent CBU, 4C and vandalism replacement projects completed across San Diego County and Southern California." crumbs={crumbs}>
  <PageHero kicker="Projects" title="Recent mailbox projects" text="A look at recent installs and replacements across Southern California." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-3">
      {PROJECTS.map((p) => (
        <figure class="card overflow-hidden !p-0">
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
            <img src={p.image} alt={`${p.title}, ${p.city}`} loading="lazy" width="800" height="600" class="h-full w-full object-cover" />
            <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-navy-950 shadow-sm"><Icon name="pin" class="h-3.5 w-3.5 text-red-600" />{p.city}</span>
          </div>
          <figcaption class="p-7"><h2 class="text-xl">{p.title}</h2><p class="mt-2 text-sm leading-relaxed text-slate-600">{p.note}</p></figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
