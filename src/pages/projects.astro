---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { PROJECTS } from '../data/site';
const crumbs = [{ name: 'Projects' }];
---
<Base title="Mailbox Installation Projects | Postal Systems" description="Recent CBU, 4C and vandalism replacement projects completed across San Diego County and Southern California." crumbs={crumbs}>
  <PageHero kicker="Projects" title="Recent mailbox projects" text="A look at recent installs and replacements across Southern California." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-3">
      {PROJECTS.map((p) => (
        <figure class="border border-blue-100">
          <img src={p.image} alt={`${p.title}, ${p.city}`} loading="lazy" width="800" height="600" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="border-t-[3px] border-red-600 p-6"><h2 class="text-2xl">{p.title}</h2><p class="font-medium text-red-600">{p.city}</p><p class="mt-2 text-slate-600">{p.note}</p></figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
