---
import Base from '../layouts/Base.astro';
import EstimateForm from '../components/EstimateForm.astro';
import FaqList from '../components/FaqList.astro';
import { SITE, STATS, SERVICES, PRODUCTS, AREAS, PROCESS, TESTIMONIALS, PROJECTS, HOME_FAQS, IMAGES } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const why = [
  { t: 'USPS compliance', d: 'Improperly installed mailboxes can mean delivery disruptions, fines or refusal of service. We install to spec and handle the approval.' },
  { t: 'Security and durability', d: 'Professionally installed systems with secure locking hardware resist tampering and unauthorized access.' },
  { t: 'Built to last', d: 'Correct pads, anchors and layouts save property owners time and money over the life of the system.' },
  { t: 'One vendor', d: 'Supply, installation, setup and repair from a single contractor, for one price.' },
];
const featured = PRODUCTS.slice(0, 3);
---
<Base
  title="Commercial Mailbox Installation & Repair San Diego | Postal Systems"
  description="USPS-approved vendor for commercial mailbox installation, CBU, 4C and parcel lockers, plus repairs and lock changes across San Diego County. California License #904106."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-navy-950 text-white">
    <img src={IMAGES.hero} alt="USPS-approved cluster box units installed by Postal Systems" width="1200" height="1200" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/20"></div>
    <div class="container-x py-28 sm:py-36 lg:py-44">
      <p class="eyebrow !text-white/70">USPS-approved vendor &middot; San Diego</p>
      <h1 class="mt-5 max-w-3xl !text-white">Commercial mailbox installation and repair, done right the first time.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">Supply, installation and USPS coordination for apartments, HOAs and commercial properties.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn btn-red">Get an estimate</a>
        <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
      </div>
      <p class="mt-8 text-sm text-white/60">California Contractor License #{SITE.license}</p>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-b border-blue-100">
    <div class="container-x grid grid-cols-2 gap-y-8 py-12 lg:grid-cols-4">
      {STATS.map((s) => (
        <div class="text-center">
          <p class="text-4xl font-semibold tracking-tight text-navy-900 sm:text-5xl">{s.value}</p>
          <p class="mt-1 text-sm text-slate-500">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">Services</p>
        <h2 class="mt-3">Mailbox services for every property type</h2>
        <p class="mt-4 text-lg text-slate-500">From a single repair to a full community install, we handle the hardware, the work and the postal service.</p>
      </div>
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((s) => (
          <a href={`/services/${s.slug}/`} class="card group block">
            <h3>{s.name}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-slate-500">{s.short}</p>
            <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-blue-700 transition group-hover:gap-2">Learn more <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section bg-blue-50">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <img src={IMAGES.oceanside} alt="Cluster mailboxes installed on a concrete pad" loading="lazy" width="1200" height="800" class="aspect-[4/3] w-full rounded-2xl object-cover" />
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2 class="mt-3">Professional installation protects your property and your residents</h2>
        <dl class="mt-10 space-y-6">
          {why.map((w) => (
            <div class="border-l-2 border-blue-700 pl-5">
              <dt class="font-semibold text-navy-950">{w.t}</dt>
              <dd class="mt-1 text-slate-500">{w.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Products</p>
          <h2 class="mt-3">USPS-approved systems we supply</h2>
        </div>
        <a href="/products/" class="btn btn-outline">View all products</a>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {featured.map((p) => (
          <a href={`/products/${p.slug}/`} class="group block">
            <div class="aspect-[4/3] overflow-hidden rounded-xl bg-blue-50"><img src={p.image} alt={p.name} loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div>
            <h3 class="mt-5">{p.name}</h3>
            <p class="mt-2 text-slate-500">{p.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section bg-navy-900 text-white">
    <div class="container-x">
      <p class="eyebrow !text-white/60">How it works</p>
      <h2 class="mt-3 max-w-2xl !text-white">From site visit to USPS handover</h2>
      <ol class="mt-14 grid gap-10 md:grid-cols-5">
        {PROCESS.map((p, i) => (
          <li>
            <p class="text-sm font-semibold text-red-500">0{i + 1}</p>
            <h3 class="mt-2 !text-white">{p.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-white/65">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Recent work</p>
      <h2 class="mt-3">Projects across Southern California</h2>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {PROJECTS.map((p) => (
          <figure>
            <img src={p.image} alt={`${p.title}, ${p.city}`} loading="lazy" width="800" height="600" class="aspect-[4/3] w-full rounded-xl object-cover" />
            <figcaption class="mt-4"><p class="font-semibold text-navy-950">{p.title}</p><p class="text-sm text-slate-500">{p.city}</p></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section bg-blue-50">
    <div class="container-x">
      <p class="eyebrow">Client feedback</p>
      <h2 class="mt-3 max-w-2xl">Trusted by property managers and boards</h2>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <blockquote class="rounded-xl bg-white p-8">
            <p class="text-xl font-medium leading-snug tracking-tight text-navy-950">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-6 text-sm text-slate-500">{t.who}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS + FAQ -->
  <section class="section">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Service areas</p>
        <h2 class="mt-3">Based in San Diego, serving Southern California</h2>
        <div class="mt-8 flex flex-wrap gap-2">
          {AREAS.map((a) => <a href={`/service-areas/${a.slug}/`} class="rounded-full border border-blue-100 px-4 py-2 text-sm font-medium text-navy-900 transition hover:border-blue-700 hover:text-blue-700">{a.name}</a>)}
        </div>
      </div>
      <div class="lg:col-span-7">
        <p class="eyebrow">FAQ</p>
        <h2 class="mb-8 mt-3">Common questions</h2>
        <FaqList faqs={HOME_FAQS} />
      </div>
    </div>
  </section>

  <!-- ESTIMATE -->
  <section class="bg-navy-900 py-20 text-white sm:py-24" id="estimate">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="!text-white">Get an estimate from an expert, fast</h2>
        <p class="mt-4 max-w-md text-lg text-white/70">Tell us what you need. We'll follow up with next steps and a detailed quote.</p>
        <a href={SITE.phoneHref} class="mt-8 inline-block text-2xl font-semibold hover:text-white/80">{SITE.phone}</a>
      </div>
      <div class="rounded-2xl bg-white p-8 text-ink">
        <EstimateForm id="home" compact />
      </div>
    </div>
  </section>
</Base>
