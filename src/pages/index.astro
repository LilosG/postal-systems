---
import Base from '../layouts/Base.astro';
import EstimateForm from '../components/EstimateForm.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { SITE, STATS, SERVICES, PRODUCTS, AREAS, AUDIENCES, PROCESS, TESTIMONIALS, PROJECTS, HOME_FAQS, IMAGES, getService } from '../data/site';

const origin = Astro.site!.origin;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const serviceCatalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Commercial & Residential Mailbox Services',
  itemListElement: SERVICES.map((s, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: s.name,
    url: `${origin}/services/${s.slug}/`,
  })),
};

const statIcons = ['clock', 'building', 'shield', 'pin'];
const serviceIcons = ['building', 'layers', 'wrench', 'award'];
const why = [
  { i: 'shield', t: 'USPS compliance', d: 'Improperly installed mailboxes can mean delivery disruptions, fines or refusal of service. We install to spec and handle approval.' },
  { i: 'lock', t: 'Security and durability', d: 'Secure locking hardware that resists tampering and unauthorized access.' },
  { i: 'layers', t: 'Built to last', d: 'Correct pads, anchors and layouts save you time and money over the life of the system.' },
  { i: 'check', t: 'One vendor', d: 'Supply, installation, setup and repair from a single contractor, for one price.' },
];
const inspectionSpecs = [
  { title: 'Concrete Pad & Anchor Engineering', note: 'Formed pads and anchor bolts matched to USPS pedestal specs' },
  { title: 'ADA Height, Reach & Clearance Audit', note: 'Documented approach and compartment reach compliance' },
  { title: 'USPS Arrow Lock & Route Registration', note: 'Direct postal coordination so carrier delivery starts on time' },
  { title: 'Resident Notice & Key Handover', note: 'Turnkey tenant notices, numbering, and organized key sets' },
];
const testimonialMeta = [
  'Turnkey CBU & USPS Sign-Off',
  'HOA Community Upgrade',
  'ADA Clearance & Inspection',
];

const flagshipServices = SERVICES.slice(0, 2);
const specializedServices = SERVICES.slice(2);
const featuredProducts = PRODUCTS.slice(0, 3);
const deepAreas = AREAS.filter((a) => a.deep);
const otherAreas = AREAS.filter((a) => !a.deep);
---
<Base
  title="Commercial Mailbox Installation & Repair San Diego | Postal Systems"
  description="USPS-approved vendor for commercial mailbox installation, CBU, 4C and parcel lockers, plus repairs and lock changes across San Diego County. California License #904106."
  schema={[faqSchema, serviceCatalogSchema]}
>
  <!-- HERO -->
  <section class="hero-bg relative isolate overflow-hidden text-white">
    <div class="door-grid absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_90%)]"></div>
    <div class="container-x grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white ring-1 ring-white/20 backdrop-blur-sm">
          <Icon name="shield" class="h-4 w-4 text-red-500" />
          USPS-Approved Vendor &bull; San Diego, CA
        </p>
        <h1 class="mt-6 !text-white">Commercial mailbox installation and repair, done right the first time.</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-blue-100/90">Turnkey mailbox supply, concrete pad installation, and USPS inspection coordination for apartments, HOAs, builders, and commercial properties.</p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="#estimate" class="btn btn-red px-8">Get a fast estimate</a>
          <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="phone" class="h-4 w-4" />{SITE.phone}</a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium text-blue-200/80">
          <span class="inline-flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-red-400" />Free site layout review</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-red-400" />Single-vendor pricing</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-red-400" />100% USPS sign-off</span>
        </div>
      </div>

      <div class="relative lg:col-span-6 lg:pl-6">
        <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-blue-700 to-red-600 opacity-25 blur-xl"></div>
        <img src={IMAGES.hero} alt="USPS-approved cluster box units installed by Postal Systems" width="1200" height="1200" fetchpriority="high" class="relative aspect-[5/4] w-full rounded-2xl object-cover shadow-[0_24px_60px_rgba(0,0,0,0.4)] ring-1 ring-white/15" />
        <div class="absolute -bottom-6 left-4 right-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white p-4 px-5 text-navy-950 shadow-2xl ring-1 ring-slate-100 sm:right-auto">
          <div class="flex items-center gap-3.5">
            <span class="icon-chip-red !h-11 !w-11 shrink-0"><Icon name="shield" class="h-5 w-5" /></span>
            <span class="text-sm leading-tight">
              <strong class="block text-base font-bold text-navy-950">CA Licensed Contractor</strong>
              <span class="text-slate-500">License #{SITE.license} &bull; Bonded &amp; Insured</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAND -->
  <section class="navy-bg border-b border-navy-800 text-white">
    <div class="container-x grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4">
      {STATS.map((s, i) => (
        <div class="flex items-center justify-center gap-5 lg:border-r lg:border-white/10 last:border-0">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-xl bg-white/5 text-blue-100 ring-1 ring-white/10"><Icon name={statIcons[i]} class="h-6 w-6" /></span>
          <div>
            <p class="font-display text-3xl font-bold tracking-tight text-white">{s.value}</p>
            <p class="text-sm font-medium text-blue-200/75">{s.label}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section bg-slate-50/60">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Turnkey Services</p>
          <h2 class="mt-2">Mailbox services for every property type</h2>
          <p class="mt-4 text-lg text-slate-500">From a single lock change to a full community install, we handle the hardware, concrete work, and postal coordination.</p>
        </div>
        <a href="/services/" class="btn btn-outline">View all 6 services</a>
      </div>

      <!-- Flagship Photo Feature Cards -->
      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        {flagshipServices.map((s) => (
          <a href={`/services/${s.slug}/`} class="group relative isolate flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-2xl p-8 text-white shadow-sm ring-1 ring-slate-200/60 transition-all hover:shadow-2xl hover:ring-blue-500/40">
            <img src={s.image} alt={s.imageAlt} loading="lazy" width="1200" height="800" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950 via-navy-950/70 to-navy-950/10"></div>
            <span class="mb-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-md">
              {s.kicker}
            </span>
            <h3 class="!text-white text-2xl sm:text-3xl">{s.name}</h3>
            <p class="mt-2 max-w-lg text-[0.95rem] leading-relaxed text-blue-50/85">{s.short}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {s.includes.slice(0, 2).map((inc) => (
                <span class="rounded-lg border border-white/15 bg-navy-950/50 px-2.5 py-1 text-xs font-medium text-blue-100 backdrop-blur-sm">{inc}</span>
              ))}
            </div>
            <span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition group-hover:bg-white group-hover:text-navy-950">
              Explore service <Icon name="arrow" class="h-4 w-4" />
            </span>
          </a>
        ))}
      </div>

      <!-- Specialized Spec Cards (Eliminates Photo Repetition) -->
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {specializedServices.map((s, idx) => (
          <a href={`/services/${s.slug}/`} class="card group flex flex-col justify-between !p-7">
            <div>
              <span class={idx % 2 === 0 ? 'icon-chip' : 'icon-chip-red'}>
                <Icon name={serviceIcons[idx]} class="h-5 w-5" />
              </span>
              <h3 class="mt-5 text-xl group-hover:text-blue-700">{s.name}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-slate-600">{s.short}</p>
              <ul class="mt-5 space-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-600">
                {s.includes.slice(0, 2).map((inc) => (
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-red-600" />
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>
            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-blue-700 transition group-hover:gap-2.5 group-hover:text-red-600">
              Learn more <Icon name="arrow" class="h-4 w-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY POSTAL SYSTEMS & USPS COMPLIANCE SPEC -->
  <section class="section border-y border-slate-100 bg-white">
    <div class="container-x grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="navy-bg relative overflow-hidden rounded-3xl p-8 text-white shadow-2xl sm:p-10">
          <div class="door-grid absolute inset-0 opacity-60"></div>
          <div class="relative z-10">
            <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-6">
              <div>
                <p class="text-xs font-bold uppercase tracking-widest text-red-400">Field Execution Standard</p>
                <h3 class="mt-1 !text-white text-2xl">USPS Inspection Ready</h3>
              </div>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-red-600 text-white shadow-lg">
                <Icon name="shield" class="h-6 w-6" />
              </span>
            </div>

            <ul class="mt-6 space-y-5">
              {inspectionSpecs.map((item) => (
                <li class="flex items-start gap-3.5">
                  <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-white/10 text-red-400">
                    <Icon name="check" class="h-4 w-4" />
                  </span>
                  <div>
                    <p class="font-display text-base font-bold text-white">{item.title}</p>
                    <p class="mt-0.5 text-xs leading-relaxed text-blue-200/75">{item.note}</p>
                  </div>
                </li>
              ))}
            </ul>

            <div class="mt-8 flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-xs">
              <span class="font-semibold text-blue-100">California Contractor License</span>
              <span class="rounded-md bg-white px-2.5 py-1 font-display font-bold text-navy-950">#{SITE.license}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <p class="eyebrow">Why Postal Systems</p>
        <h2 class="mt-2">Professional installation protects your property and your residents</h2>
        <p class="mt-4 text-lg text-slate-500">Secure, compliant mail delivery prevents carrier holds, resident complaints, and costly rework.</p>
        <div class="mt-9 grid gap-5 sm:grid-cols-2">
          {why.map((w) => (
            <div class="card !p-6">
              <span class="icon-chip-red"><Icon name={w.i} /></span>
              <h3 class="mt-4 text-lg">{w.t}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-slate-600">{w.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHO WE SERVE (B2B BUYER ROUTING) -->
  <section class="section bg-slate-50/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Who We Work With</p>
          <h2 class="mt-2">Built for property managers, boards, and builders</h2>
          <p class="mt-4 text-lg text-slate-500">One point of contact from layout review and resident notices to final postal inspection.</p>
        </div>
        <a href="/who-we-work-with/" class="btn btn-outline">See all industries</a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {AUDIENCES.map((aud) => (
          <div class="card flex flex-col justify-between !p-7">
            <div>
              <h3 class="text-xl">{aud.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{aud.text}</p>
            </div>
            <div class="mt-6 space-y-2 border-t border-slate-100 pt-5">
              {aud.services.map((slug) => {
                const sv = getService(slug);
                return (
                  <a href={`/services/${sv.slug}/`} class="flex items-center justify-between rounded-lg bg-slate-50 px-3.5 py-2 text-xs font-bold text-navy-950 transition hover:bg-blue-50 hover:text-blue-700">
                    <span>{sv.name}</span>
                    <Icon name="arrow" class="h-3.5 w-3.5 text-red-600" />
                  </a>
                );
              })}
            </div>
          </div>
        ))}
        <div class="hero-bg flex flex-col justify-between rounded-2xl p-7 text-white shadow-lg">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-blue-100">Custom Specs &amp; Retrofits</span>
            <h3 class="mt-4 !text-white text-xl">Planning a new build or community upgrade?</h3>
            <p class="mt-3 text-sm leading-relaxed text-blue-100/80">Send us your site plan or address count and we will size the exact USPS-approved CBU, 4C, or parcel locker layout.</p>
          </div>
          <a href="#estimate" class="btn btn-red mt-6 w-full">Request a layout quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section border-t border-slate-100 bg-white">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Hardware &amp; Systems</p>
          <h2 class="mt-2">USPS-approved systems we supply</h2>
        </div>
        <a href="/products/" class="btn btn-outline">View all 6 products</a>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {featuredProducts.map((p) => (
          <a href={`/products/${p.slug}/`} class="card group flex flex-col overflow-hidden !p-0">
            <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
              <img src={p.image} alt={p.name} loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
              <span class="absolute left-4 top-4 rounded-full bg-navy-950/85 px-3 py-1 text-xs font-bold text-white backdrop-blur-sm">USPS-Approved</span>
            </div>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="text-xl group-hover:text-blue-700">{p.name}</h3>
              <p class="mt-3 text-[0.95rem] text-slate-500">{p.short}</p>
              <ul class="mb-8 mt-6 flex-1 space-y-3 text-sm text-slate-600">
                {p.features.slice(0, 3).map((f) => <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-red-600" />{f}</li>)}
              </ul>
              <span class="inline-flex items-center gap-2 text-[0.95rem] font-semibold text-blue-700 transition group-hover:gap-3 group-hover:text-red-600">View specifications <Icon name="arrow" class="h-4 w-4" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="hero-bg relative isolate overflow-hidden py-24 text-white sm:py-32">
    <div class="door-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_70%)]"></div>
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow !text-blue-200">How It Works</p>
        <h2 class="mt-2 !text-white">From site visit to USPS handover</h2>
        <p class="mt-5 text-lg text-blue-100">One vendor, five steps, one price.</p>
      </div>
      <ol class="relative mt-16 grid gap-10 md:grid-cols-5">
        <div class="absolute left-0 right-0 top-6 hidden h-px bg-blue-300/20 md:block"></div>
        {PROCESS.map((p, i) => (
          <li class="relative">
            <span class="relative grid h-12 w-12 place-items-center rounded-full bg-red-600 text-lg font-bold text-white shadow-lg ring-8 ring-[#002d52]">{i + 1}</span>
            <h3 class="mt-6 text-xl !text-white">{p.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-blue-100/75">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section bg-slate-50/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Recent Work</p>
          <h2 class="mt-2 max-w-2xl">Recent projects across Southern California</h2>
        </div>
        <a href="/projects/" class="btn btn-outline">All projects</a>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {PROJECTS.map((p) => (
          <figure class="group relative isolate overflow-hidden rounded-2xl bg-slate-100 shadow-sm ring-1 ring-slate-200 transition-all hover:shadow-xl hover:ring-blue-500/30">
            <img src={p.image} alt={`${p.title}, ${p.city}`} loading="lazy" width="800" height="1000" class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/95 via-navy-950/25 to-transparent"></div>
            <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3.5 py-1.5 text-xs font-bold text-navy-950 shadow-sm backdrop-blur"><Icon name="pin" class="h-3.5 w-3.5 text-red-600" />{p.city}</span>
            <figcaption class="absolute inset-x-0 bottom-0 p-7 text-white">
              <p class="text-xl font-bold tracking-tight">{p.title}</p>
              <p class="mt-1.5 text-[0.92rem] text-blue-100/85">{p.note}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section border-t border-slate-100 bg-white">
    <div class="container-x">
      <p class="eyebrow">Client Feedback</p>
      <h2 class="mt-2 max-w-2xl">Trusted by property managers and boards</h2>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {TESTIMONIALS.map((t, i) => (
          <blockquote class="card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <div class="flex gap-1 text-red-600">
                  {[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-4 w-4" />)}
                </div>
                <span class="rounded-full bg-blue-50 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-wider text-blue-700">
                  {testimonialMeta[i]}
                </span>
              </div>
              <p class="mt-6 font-display text-xl font-bold leading-snug text-navy-950">"{t.quote}"</p>
            </div>
            <footer class="mt-8 flex items-center gap-3.5 border-t border-slate-100 pt-5">
              <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-navy-950 text-sm font-bold text-white">{t.who.charAt(0)}</div>
              <div>
                <p class="text-sm font-bold text-navy-950">{t.who}</p>
                <p class="text-xs text-slate-500">Verified Commercial Project</p>
              </div>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS + FAQS -->
  <section class="section bg-slate-50/50">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Local Coverage</p>
        <h2 class="mt-2">Based in San Diego, serving Southern California</h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600">Fast, local response times for community and commercial installations across San Diego County, plus select projects in Riverside and Orange Counties.</p>

        <div class="mt-7">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Primary Service Hubs</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {deepAreas.map((a) => (
              <a href={`/service-areas/${a.slug}/`} class="inline-flex items-center gap-1.5 rounded-full bg-blue-700 px-4 py-2 text-sm font-semibold text-white shadow-xs transition hover:bg-navy-950">
                <Icon name="pin" class="h-3.5 w-3.5 text-red-400" />
                {a.name}
              </a>
            ))}
          </div>
        </div>

        <div class="mt-6">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Surrounding Cities &amp; Counties</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {otherAreas.map((a) => (
              <a href={`/service-areas/${a.slug}/`} class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm font-semibold text-navy-950 shadow-xs transition hover:border-blue-700 hover:text-blue-700">
                {a.name}
              </a>
            ))}
          </div>
        </div>

        <a href="/service-areas/" class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-red-600 hover:text-red-700">
          View all 13 service areas <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <div class="lg:col-span-7">
        <p class="eyebrow">FAQ</p>
        <h2 class="mb-8 mt-2">Common questions</h2>
        <FaqList faqs={HOME_FAQS} />
      </div>
    </div>
  </section>

  <!-- ESTIMATE CTA -->
  <section class="container-x pb-24" id="estimate">
    <div class="red-bg relative isolate overflow-hidden rounded-3xl px-8 py-14 text-white shadow-[0_24px_60px_rgba(218,41,28,0.24)] sm:px-14 sm:py-16">
      <div class="door-grid absolute inset-0 -z-10 opacity-70 [mask-image:linear-gradient(to_right,black,transparent_80%)]"></div>
