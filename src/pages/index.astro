---
import Base from '../layouts/Base.astro';
import EstimateForm from '../components/EstimateForm.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { SITE, STATS, SERVICES, PRODUCTS, AREAS, PROCESS, TESTIMONIALS, PROJECTS, HOME_FAQS, IMAGES } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const statIcons = ['clock', 'building', 'shield', 'pin'];
const why = [
  { i: 'shield', t: 'USPS compliance', d: 'Improperly installed mailboxes can mean delivery disruptions, fines or refusal of service. We install to spec and handle approval.' },
  { i: 'lock', t: 'Security and durability', d: 'Secure locking hardware that resists tampering and unauthorized access.' },
  { i: 'layers', t: 'Built to last', d: 'Correct pads, anchors and layouts save you time and money over the life of the system.' },
  { i: 'check', t: 'One vendor', d: 'Supply, installation, setup and repair from a single contractor, for one price.' },
];
const spans = ['lg:col-span-7', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-7', 'lg:col-span-6', 'lg:col-span-6'];
const featured = PRODUCTS.slice(0, 3);
---
<Base
  title="Commercial Mailbox Installation & Repair San Diego | Postal Systems"
  description="USPS-approved vendor for commercial mailbox installation, CBU, 4C and parcel lockers, plus repairs and lock changes across San Diego County. California License #904106."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="hero-bg relative isolate overflow-hidden text-white">
    <div class="door-grid absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent_90%)]"></div>
    <div class="container-x grid items-center gap-16 py-20 sm:py-28 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold text-white ring-1 ring-white/20 backdrop-blur-sm"><Icon name="shield" class="h-4 w-4 text-red-500" />USPS-approved vendor in San Diego</p>
        <h1 class="mt-6 !text-white">Mailbox installation and repair, done right the first time.</h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-blue-100">Supply, installation and USPS coordination for apartments, HOAs and commercial properties.</p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="/contact/" class="btn btn-red px-8">Get an estimate</a>
          <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="phone" class="h-4 w-4" />{SITE.phone}</a>
        </div>
      </div>
      <div class="relative lg:col-span-6 lg:pl-6">
        <div class="absolute -inset-2 rounded-2xl bg-gradient-to-tr from-blue-700 to-red-600 opacity-25 blur-xl"></div>
        <img src={IMAGES.hero} alt="USPS-approved cluster box units installed by Postal Systems" width="1200" height="1200" fetchpriority="high" class="relative aspect-[5/4] w-full rounded-2xl object-cover shadow-[0_20px_50px_rgba(0,0,0,0.35)] ring-1 ring-white/15" />
        <div class="absolute -bottom-6 -left-4 flex items-center gap-4 rounded-xl bg-white p-4 pr-6 text-navy-950 shadow-2xl ring-1 ring-slate-100">
          <span class="icon-chip-red !h-12 !w-12"><Icon name="check" class="h-6 w-6" /></span>
          <span class="text-sm leading-tight"><strong class="block text-base">California licensed</strong><span class="text-slate-500">License #{SITE.license}</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAND -->
  <section class="navy-bg border-b border-navy-800 text-white">
    <div class="container-x grid grid-cols-2 gap-y-10 py-12 lg:grid-cols-4">
      {STATS.map((s, i) => (
        <div class="flex items-center justify-center gap-5 lg:border-r lg:border-white/10 last:border-0">
          <span class="grid h-14 w-14 place-items-center rounded-xl bg-white/5 text-blue-100 ring-1 ring-white/10"><Icon name={statIcons[i]} class="h-6 w-6" /></span>
          <div><p class="text-3xl font-bold tracking-tight text-white">{s.value}</p><p class="text-sm font-medium text-blue-200/70">{s.label}</p></div>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section bg-slate-50/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Turnkey Services</p>
          <h2 class="mt-2">Mailbox services for every property type</h2>
          <p class="mt-4 text-lg text-slate-500">From a single repair to a full community install, we handle the hardware, the work and the postal service.</p>
        </div>
        <a href="/services/" class="btn btn-outline">All services</a>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-12">
        {SERVICES.map((s, i) => (
          <a href={`/services/${s.slug}/`} class:list={['group relative isolate flex min-h-[21rem] flex-col justify-end overflow-hidden rounded-2xl p-8 text-white shadow-sm ring-1 ring-slate-200/50 transition-all hover:shadow-xl hover:ring-blue-500/30', spans[i]]}>
            <img src={s.image} alt={s.imageAlt} loading="lazy" width="1200" height="800" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 -z-10 bg-gradient-to-t from-navy-950/95 via-navy-950/60 to-transparent"></div>
            <span class="mb-5 block h-1 w-10 rounded-full bg-red-600 transition-all group-hover:w-16"></span>
            <h3 class="!text-white text-2xl tracking-tight">{s.name}</h3>
            <p class="mt-2 max-w-md text-[0.95rem] text-blue-50/85">{s.short}</p>
            <span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold backdrop-blur-md transition group-hover:bg-red-600 group-hover:text-white">Learn more <Icon name="arrow" class="h-4 w-4" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section border-y border-slate-100 bg-white">
    <div class="container-x grid items-center gap-16 lg:grid-cols-2">
      <div class="relative lg:pr-8">
        <div class="absolute -left-4 -top-4 h-32 w-32 rounded-tl-3xl border-l-[6px] border-t-[6px] border-red-600/20"></div>
        <img src={IMAGES.oceanside} alt="Cluster mailboxes installed on a concrete pad" loading="lazy" width="1200" height="900" class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-2xl shadow-blue-900/10 ring-1 ring-slate-200" />
      </div>
      <div>
        <p class="eyebrow">Why Postal Systems</p>
        <h2 class="mt-2">Professional installation protects your property and your residents</h2>
        <p class="mt-5 text-lg text-slate-500">Secure, compliant mail delivery is more critical than ever.</p>
        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {why.map((w) => (
            <div class="card !p-6">
              <span class="icon-chip-red"><Icon name={w.i} /></span>
              <h3 class="mt-5 text-lg">{w.t}</h3>
              <p class="mt-2 text-[0.92rem] leading-relaxed text-slate-500">{w.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section bg-slate-50/40">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="eyebrow">Hardware &amp; Systems</p>
          <h2 class="mt-2">USPS-approved systems we supply</h2>
        </div>
        <a href="/products/" class="btn btn-outline">View all products</a>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {featured.map((p) => (
          <a href={`/products/${p.slug}/`} class="card group flex flex-col overflow-hidden !p-0">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100"><img src={p.image} alt={p.name} loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" /></div>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="text-xl">{p.name}</h3>
              <p class="mt-3 text-[0.95rem] text-slate-500">{p.short}</p>
              <ul class="mb-8 mt-6 flex-1 space-y-3 text-sm text-slate-600">
                {p.features.slice(0, 3).map((f) => <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-red-600" />{f}</li>)}
              </ul>
              <span class="inline-flex items-center gap-2 text-[0.95rem] font-semibold text-blue-700 transition group-hover:gap-3 group-hover:text-red-600">View details <Icon name="arrow" class="h-4 w-4" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="hero-bg relative isolate overflow-hidden py-24 text-white sm:py-32">
    <div class="door-grid absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_top_right,black,transparent_70%)]"></div>
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow !text-blue-200">How It Works</p>
        <h2 class="mt-2 !text-white">From site visit to USPS handover</h2>
        <p class="mt-5 text-lg text-blue-100">One vendor, five steps, one price.</p>
      </div>
      <ol class="relative mt-16 grid gap-10 md:grid-cols-5">
        <div class="absolute left-0 right-0 top-6 hidden h-px bg-blue-300/20 md:block"></div>
        {PROCESS.map((p, i) => (
          <li class="relative">
            <span class="relative grid h-12 w-12 place-items-center rounded-full bg-red-600 text-lg font-bold text-white shadow-lg ring-8 ring-[#002d52]">{i + 1}</span>
            <h3 class="mt-6 text-xl !text-white">{p.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-blue-100/75">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section bg-slate-50/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Recent Work</p>
          <h2 class="mt-2 max-w-2xl">Recent projects across Southern California</h2>
        </div>
        <a href="/projects/" class="btn btn-outline">All projects</a>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {PROJECTS.map((p) => (
          <figure class="group relative isolate overflow-hidden rounded-2xl bg-slate-100 shadow-sm ring-1 ring-slate-200 transition-all hover:shadow-xl hover:ring-blue-500/30">
            <img src={p.image} alt={`${p.title}, ${p.city}`} loading="lazy" width="800" height="1000" class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/20 to-transparent"></div>
            <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3.5 py-1.5 text-xs font-bold text-navy-950 shadow-sm backdrop-blur"><Icon name="pin" class="h-3.5 w-3.5 text-red-600" />{p.city}</span>
            <figcaption class="absolute inset-x-0 bottom-0 p-7 text-white"><p class="text-xl font-bold tracking-tight">{p.title}</p><p class="mt-1.5 text-[0.9rem] text-blue-100/85">{p.note}</p></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section border-t border-slate-100 bg-white">
    <div class="container-x">
      <p class="eyebrow">Client Feedback</p>
      <h2 class="mt-2 max-w-2xl">Trusted by property managers and boards</h2>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <blockquote class="card flex flex-col justify-between">
            <div>
              <div class="mb-6 flex gap-1 text-red-600">
                {[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-5 w-5" />)}
              </div>
              <p class="text-lg font-medium leading-relaxed text-navy-950">"{t.quote}"</p>
            </div>
            <footer class="mt-8 flex items-center gap-3.5 border-t border-slate-100 pt-6">
              <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-blue-50 text-sm font-bold text-blue-700">{t.who.charAt(0)}</div>
              <p class="text-sm font-semibold text-slate-600">{t.who}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS + FAQS -->
  <section class="section bg-slate-50/50">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow">Local Coverage</p>
        <h2 class="mt-2">Based in San Diego, serving Southern California</h2>
        <p class="mt-5 text-lg text-slate-500">Fast, local response times for community and commercial installations across San Diego County and nearby regions.</p>
        <div class="mt-8 flex flex-wrap gap-2.5">
          {AREAS.map((a) => (
            <a href={`/service-areas/${a.slug}/`} class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-navy-950 shadow-xs transition hover:border-blue-700 hover:bg-blue-700 hover:text-white">
              <Icon name="pin" class="h-3.5 w-3.5 text-red-600" />
              {a.name}
            </a>
          ))}
        </div>
      </div>
      <div class="lg:col-span-7">
        <p class="eyebrow">FAQ</p>
        <h2 class="mb-8 mt-2">Common questions</h2>
        <FaqList faqs={HOME_FAQS} />
      </div>
    </div>
  </section>

  <!-- ESTIMATE CTA -->
  <section class="container-x pb-24" id="estimate">
    <div class="red-bg relative isolate overflow-hidden rounded-3xl px-8 py-14 text-white shadow-[0_24px_60px_rgba(218,41,28,0.24)] sm:px-14 sm:py-16">
      <div class="door-grid absolute inset-0 -z-10 opacity-70 [mask-image:linear-gradient(to_right,black,transparent_80%)]"></div>
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white">Fast Quote &bull; One Vendor</p>
          <h2 class="mt-4 !text-white">Get an estimate from an expert, fast</h2>
          <p class="mt-4 max-w-md text-lg text-white/85">Tell us what you need. We'll follow up with next steps and a detailed quote covering hardware, installation, and USPS sign-off.</p>
          <a href={SITE.phoneHref} class="mt-8 inline-flex items-center gap-3.5 text-2xl font-bold text-white transition hover:text-white/80">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/15 ring-1 ring-white/25"><Icon name="phone" class="h-5 w-5" /></span>
            {SITE.phone}
          </a>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-2xl bg-white p-8 text-ink shadow-2xl ring-1 ring-black/5">
            <h3 class="mb-1 text-xl">Request a fast quote</h3>
            <p class="mb-5 text-sm text-slate-500">No obligation. Response within one business day.</p>
            <EstimateForm id="home" compact />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
