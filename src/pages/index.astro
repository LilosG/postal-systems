---
import Base from '../layouts/Base.astro';
import EstimateForm from '../components/EstimateForm.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, STATS, SERVICES, PRODUCTS, AREAS, AUDIENCES, PROCESS, TESTIMONIALS, PROJECTS, HOME_FAQS, IMAGES } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const why = [
  { t: 'Compliance with USPS regulations', d: 'Improperly installed mailboxes can lead to delivery disruptions, fines, or even refusal of service. We install to USPS requirements and handle the approval.' },
  { t: 'Enhanced security and durability', d: 'Professionally installed systems resist tampering and unauthorized access, with secure locking hardware.' },
  { t: 'Precision installation, long-term reliability', d: 'Correct pads, anchors and layouts save property owners time and money over the life of the system.' },
  { t: 'One vendor for everything', d: 'Supply, installation, setup and repair from a single contractor, for one price.' },
];
const cities = AREAS;
---
<Base
  title="Commercial Mailbox Installation & Repair San Diego | Postal Systems"
  description="USPS-approved vendor for commercial mailbox installation, CBU, 4C and parcel lockers, plus repairs and lock changes across San Diego County. California License #904106."
  schema={[faqSchema]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-navy-950 text-white">
    <img src={IMAGES.hero} alt="USPS-approved cluster box units installed by Postal Systems" width="1200" height="1200" class="absolute inset-0 h-full w-full object-cover opacity-40" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-900/50"></div>
    <div class="container-x relative grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow !text-red-500 mb-4">USPS-Approved Vendor &middot; San Diego, CA</p>
        <h1 class="!text-white">Commercial mailbox installation &amp; repair, <span class="text-red-500">done once and done right.</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
          Supply, installation and USPS coordination for apartments, HOAs and commercial properties of any size. CBUs, 4C mailboxes, parcel lockers, repairs and lock changes from one licensed contractor.
        </p>
        <ul class="mt-7 grid gap-3 text-lg font-medium sm:grid-cols-2">
          {['USPS-approved vendor', 'California Contractor License #' + SITE.license, 'Turnkey: hardware, pads and USPS sign-off', 'Serving San Diego County & beyond'].map((t) => (
            <li class="flex items-start gap-3"><svg viewBox="0 0 20 20" class="mt-1 h-5 w-5 shrink-0 text-red-500" fill="currentColor"><path d="M7.6 14.2 3.4 10l1.4-1.4 2.8 2.8 7.6-7.6L16.6 5z"/></svg>{t}</li>
          ))}
        </ul>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/" class="btn btn-red">Get an Estimate</a>
          <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="relative bg-white p-7 text-ink shadow-2xl">
          <div class="stripe absolute inset-x-0 top-0 h-[6px]"></div>
          <h2 class="text-3xl">Get a free estimate</h2>
          <p class="mb-5 mt-1 text-slate-500">Three quick fields. We'll call you back.</p>
          <EstimateForm id="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-b border-blue-100 bg-white">
    <div class="container-x grid grid-cols-2 gap-y-8 py-10 lg:grid-cols-4">
      {STATS.map((s) => (
        <div class="text-center lg:border-r lg:border-blue-100 last:border-0">
          <p class="font-display text-5xl font-bold text-red-600 sm:text-6xl">{s.value}</p>
          <p class="mt-1 font-display text-lg font-medium uppercase tracking-wider text-navy-900">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section bg-blue-50/60">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">What we do</p>
        <h2 class="mt-2">Mailbox services for every property type</h2>
        <p class="mt-4 text-lg text-slate-600">From a single repair to a full community install, we handle the hardware, the work and the postal service.</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((s, i) => (
          <a href={`/services/${s.slug}/`} class="card group block">
            <span class="font-display text-5xl font-bold text-blue-100 transition group-hover:text-red-600/30">0{i + 1}</span>
            <h3 class="mt-1">{s.name}</h3>
            <p class="mt-3 text-slate-600">{s.short}</p>
            <span class="mt-5 inline-block font-display text-lg font-semibold uppercase tracking-wide text-red-600">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section bg-navy-900 text-white">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow !text-red-500">Why professional installation matters</p>
        <h2 class="mt-2 !text-white">Secure, compliant mail delivery is more critical than ever</h2>
      </div>
      <div class="mt-12 grid gap-px bg-white/15 sm:grid-cols-2">
        {why.map((w) => (
          <div class="bg-navy-900 p-8">
            <h3 class="!text-white">{w.t}</h3>
            <p class="mt-3 text-lg text-white/75">{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <p class="eyebrow">Our products</p>
          <h2 class="mt-2">USPS-approved mailbox systems we supply</h2>
        </div>
        <a href="/products/" class="btn btn-outline">All products</a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PRODUCTS.map((p) => (
          <a href={`/products/${p.slug}/`} class="group block overflow-hidden border border-blue-100 bg-white transition hover:border-blue-600 hover:shadow-xl">
            <div class="aspect-[16/10] overflow-hidden"><img src={p.image} alt={p.name} loading="lazy" width="800" height="500" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div>
            <div class="border-t-[3px] border-red-600 p-6">
              <h3>{p.name}</h3>
              <p class="mt-2 text-slate-600">{p.short}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section bg-blue-50/60">
    <div class="container-x">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-2 max-w-3xl">From site visit to USPS handover</h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-5">
        {PROCESS.map((p, i) => (
          <li class="relative bg-white p-6 pt-16">
            <span class="absolute -top-0 left-0 grid h-12 w-12 place-items-center bg-red-600 font-display text-2xl font-bold text-white">{i + 1}</span>
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-2 text-slate-600">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHO -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">Who we work with</p>
        <h2 class="mt-2">Built for property professionals</h2>
        <a href="/who-we-work-with/" class="btn btn-outline mt-8">See who we serve</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        {AUDIENCES.map((a) => (
          <li class="border-l-4 border-red-600 bg-blue-50/60 p-5">
            <h3 class="text-xl">{a.name}</h3>
            <p class="mt-1 text-slate-600">{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="section bg-navy-950 text-white">
    <div class="container-x">
      <p class="eyebrow !text-red-500">Recent work</p>
      <h2 class="mt-2 !text-white">Projects across Southern California</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {PROJECTS.map((p) => (
          <figure>
            <img src={p.image} alt={`${p.title}, ${p.city}`} loading="lazy" width="800" height="600" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="border-t-[3px] border-red-600 bg-navy-900 p-5">
              <p class="font-display text-2xl font-semibold">{p.title}</p>
              <p class="text-white/70">{p.city} &middot; {p.note}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">What clients say</p>
      <h2 class="mt-2">Trusted by property managers and boards</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <blockquote class="border border-blue-100 p-7">
            <p class="font-display text-3xl leading-tight text-navy-950">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-5 font-medium text-red-600">{t.who}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="section bg-blue-50/60">
    <div class="container-x">
      <p class="eyebrow">Service areas</p>
      <h2 class="mt-2 max-w-3xl">Based in San Diego, serving Southern California</h2>
      <div class="mt-10 flex flex-wrap gap-3">
        {cities.map((a) => (
          <a href={`/service-areas/${a.slug}/`} class="border border-blue-100 bg-white px-5 py-3 font-display text-lg font-semibold text-navy-900 transition hover:border-red-600 hover:text-red-600">{a.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-2">Common questions</h2>
      </div>
      <div class="lg:col-span-8"><FaqList faqs={HOME_FAQS} /></div>
    </div>
  </section>

  <CtaBand />
</Base>
