---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { PRODUCTS, SERVICES } from '../../data/site';
export function getStaticPaths() { return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const crumbs = [{ name: 'Products', href: '/products/' }, { name: p.name }];
const schema = [{ '@context': 'https://schema.org', '@type': 'Product', name: p.name, description: p.intro, brand: { '@type': 'Brand', name: 'Postal Systems' }, image: `${Astro.site!.origin}${p.image}` }];
const related = SERVICES.filter((s) => s.productSlugs.includes(p.slug));
---
<Base title={`${p.name} | USPS-Approved | Postal Systems San Diego`} description={`${p.short} Supplied and installed by Postal Systems, a USPS-approved vendor in San Diego.`} crumbs={crumbs} schema={schema} image={p.image}>
  <PageHero kicker="Product" title={p.name} text={p.intro} image={p.image} imageAlt={p.name} crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">Specifications</p>
        <h2 class="mt-2">Key features</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {p.features.map((f: string) => (
            <li class="flex items-center gap-3 rounded-xl border border-slate-200/80 bg-white p-4 text-base font-semibold text-navy-950 shadow-xs">
              <Icon name="check" class="h-5 w-5 shrink-0 text-red-600" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 text-base text-slate-700">
          <strong class="text-navy-950">Common uses:</strong> {p.useCases}
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="navy-bg rounded-2xl p-8 text-white shadow-xl">
          <p class="text-xs font-bold uppercase tracking-wider text-blue-200">Turnkey Installation</p>
          <h2 class="mt-2 !text-white text-2xl">Related services</h2>
          <ul class="mt-5 space-y-3">{related.map((s) => <li><a class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3.5 font-display text-lg font-semibold transition hover:border-white/25 hover:bg-white/10" href={`/services/${s.slug}/`}><span>{s.name}</span><Icon name="arrow" class="h-4 w-4 text-red-400" /></a></li>)}</ul>
          <a href="/contact/" class="btn btn-red mt-7 w-full">Request a Quote</a>
        </div>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
