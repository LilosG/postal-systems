---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { PRODUCTS } from '../../data/site';
const crumbs = [{ name: 'Products' }];
---
<Base title="USPS-Approved Mailboxes: CBU, 4C, Parcel Lockers | Postal Systems" description="We supply cluster box units, 4C mailboxes, parcel lockers, letter lockers, tub lockers and residential locking mailboxes in San Diego." crumbs={crumbs}>
  <PageHero kicker="Products" title="USPS-approved mailbox systems" text="We supply all types of commercial and residential mailboxes and install them to USPS requirements." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {PRODUCTS.map((p) => (
        <a href={`/products/${p.slug}/`} class="card group flex flex-col overflow-hidden !p-0">
          <div class="aspect-[16/10] overflow-hidden bg-slate-100"><img src={p.image} alt={p.name} loading="lazy" width="800" height="500" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div>
          <div class="flex flex-1 flex-col justify-between p-7">
            <div>
              <h2 class="text-xl group-hover:text-blue-700">{p.name}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.short}</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-red-600 transition group-hover:gap-3">View details <Icon name="arrow" class="h-4 w-4" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
