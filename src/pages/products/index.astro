---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { PRODUCTS } from '../../data/site';
const crumbs = [{ name: 'Products' }];
---
<Base title="USPS-Approved Mailboxes: CBU, 4C, Parcel Lockers | Postal Systems" description="We supply cluster box units, 4C mailboxes, parcel lockers, letter lockers, tub lockers and residential locking mailboxes in San Diego." crumbs={crumbs}>
  <PageHero kicker="Products" title="USPS-approved mailbox systems" text="We supply all types of commercial and residential mailboxes and install them to USPS requirements." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {PRODUCTS.map((p) => (
        <a href={`/products/${p.slug}/`} class="group block overflow-hidden border border-blue-100 transition hover:border-blue-600 hover:shadow-xl">
          <div class="aspect-[16/10] overflow-hidden"><img src={p.image} alt={p.name} loading="lazy" width="800" height="500" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div>
          <div class="border-t-[3px] border-red-600 p-6"><h2 class="text-2xl">{p.name}</h2><p class="mt-2 text-slate-600">{p.short}</p><span class="mt-4 inline-block font-display text-lg font-semibold text-red-600">View details &rarr;</span></div>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
