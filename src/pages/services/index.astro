---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES, DEEP_AREAS } from '../../data/site';
const crumbs = [{ name: 'Services' }];
---
<Base title="Mailbox Installation & Repair Services San Diego | Postal Systems" description="CBU installation, 4C wall-mounted mailboxes, parcel lockers, ADA-compliant installs, repairs and lock changes by a USPS-approved vendor in San Diego County." crumbs={crumbs}>
  <PageHero kicker="Services" title="Mailbox services, start to finish" text="USPS-approved supply, installation, repair and lock changes for commercial and residential properties." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-6 md:grid-cols-2">
      {SERVICES.map((s) => (
        <article class="card">
          <h2 class="text-3xl"><a href={`/services/${s.slug}/`} class="hover:text-red-600">{s.name}</a></h2>
          <p class="mt-3 text-slate-600">{s.short}</p>
          <ul class="mt-4 space-y-1 text-slate-600">{s.includes.slice(0, 3).map((i) => <li class="flex gap-2"><span class="text-red-600">&#9632;</span>{i}</li>)}</ul>
          <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-display text-lg font-semibold">
            <a class="text-red-600" href={`/services/${s.slug}/`}>Details &rarr;</a>
            {DEEP_AREAS.map((a) => <a class="text-navy-800 hover:text-red-600" href={`/service-areas/${a.slug}/${s.slug}/`}>{a.name}</a>)}
          </p>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
