---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES, DEEP_AREAS } from '../../data/site';
const crumbs = [{ name: 'Services' }];
---
<Base title="Mailbox Installation & Repair Services San Diego | Postal Systems" description="CBU installation, 4C wall-mounted mailboxes, parcel lockers, ADA-compliant installs, repairs and lock changes by a USPS-approved vendor in San Diego County." crumbs={crumbs}>
  <PageHero kicker="Services" title="Mailbox services, start to finish" text="USPS-approved supply, installation, repair and lock changes for commercial and residential properties." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-2">
      {SERVICES.map((s) => (
        <article class="card flex flex-col justify-between">
          <div>
            <h2 class="text-2xl"><a href={`/services/${s.slug}/`} class="transition hover:text-blue-700">{s.name}</a></h2>
            <p class="mt-3 text-slate-600">{s.short}</p>
            <ul class="mt-5 space-y-2 text-sm text-slate-600">{s.includes.slice(0, 3).map((i) => <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-red-600" />{i}</li>)}</ul>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-slate-100 pt-5 font-display text-sm font-bold">
            <a class="text-red-600 hover:text-red-700" href={`/services/${s.slug}/`}>Service details &rarr;</a>
            {DEEP_AREAS.map((a) => <a class="rounded-full bg-blue-50 px-3 py-1 text-blue-700 transition hover:bg-blue-700 hover:text-white" href={`/service-areas/${a.slug}/${s.slug}/`}>{a.name}</a>)}
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
