---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES, AREAS, DEEP_AREAS, PROCESS, getProduct, SITE } from '../../data/site';

export function getStaticPaths() { return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } })); }
const { s: svc } = Astro.props;
const crumbs = [{ name: 'Services', href: '/services/' }, { name: svc.name }];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: svc.name, serviceType: svc.name, description: svc.intro,
    provider: { '@id': `${Astro.site!.origin}/#business` }, areaServed: AREAS.map((a) => ({ '@type': a.type === 'city' ? 'City' : 'AdministrativeArea', name: a.name })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: svc.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const others = SERVICES.filter((x) => x.slug !== svc.slug);
---
<Base title={`${svc.name} San Diego | Postal Systems`} description={`${svc.short} USPS-approved vendor serving San Diego County. California License #${SITE.license}.`} crumbs={crumbs} schema={schema} image={svc.image}>
  <PageHero kicker={svc.kicker} title={svc.h1} text={svc.intro} image={svc.image} imageAlt={svc.imageAlt} crumbs={crumbs} />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">What's included</p>
        <h2 class="mt-2">Everything handled by one vendor</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {svc.includes.map((i: string) => (
            <li class="flex items-start gap-3 rounded-xl border border-slate-200/80 bg-white p-4 text-base font-semibold text-navy-950 shadow-xs">
              <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-red-600" />
              <span>{i}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 text-base text-slate-700">
          <strong class="text-navy-950">Best for:</strong> {svc.bestFor}
        </div>
      </div>
      <aside class="lg:col-span-5">
        <div class="navy-bg rounded-2xl p-8 text-white shadow-xl">
          <p class="text-xs font-bold uppercase tracking-wider text-blue-200">USPS-Approved Hardware</p>
          <h3 class="mt-2 !text-white">Related products</h3>
          <ul class="mt-5 space-y-3">
            {svc.productSlugs.map((p: string) => { const pr = getProduct(p); return <li><a class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3.5 font-display text-lg font-semibold transition hover:border-white/25 hover:bg-white/10" href={`/products/${pr.slug}/`}><span>{pr.name}</span><Icon name="arrow" class="h-4 w-4 text-red-400" /></a></li>; })}
          </ul>
          <a href="/contact/" class="btn btn-red mt-7 w-full">Get an estimate</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section border-y border-slate-100 bg-slate-50/60">
    <div class="container-x">
      <p class="eyebrow">Local Service Pages</p>
      <h2 class="mt-2">{svc.name} by location</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {DEEP_AREAS.map((a) => (
          <a class="card group flex items-center justify-between !p-6" href={`/service-areas/${a.slug}/${svc.slug}/`}>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">{a.region}</span>
              <p class="mt-1 font-display text-xl font-bold text-navy-950 group-hover:text-blue-700">{svc.name} in {a.name}</p>
            </div>
            <Icon name="arrow" class="h-5 w-5 shrink-0 text-red-600 transition group-hover:translate-x-1" />
          </a>
        ))}
      </div>
      <p class="mt-6 flex flex-wrap items-center gap-2 text-sm text-slate-600">
        <span class="font-semibold text-navy-950">Also serving:</span>
        {AREAS.filter((a) => !a.deep).map((a) => <a class="rounded-full border border-slate-200 bg-white px-3 py-1 font-medium text-navy-950 transition hover:border-blue-700 hover:text-blue-700" href={`/service-areas/${a.slug}/`}>{a.name}</a>)}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Our process</p>
      <h2 class="mt-2">What to expect</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-5">
        {PROCESS.map((p, i) => (
          <li class="card !p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-50 font-display text-sm font-bold text-red-600">0{i + 1}</span>
            <h3 class="mt-4 text-lg">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section border-t border-slate-100 bg-slate-50/50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4"><p class="eyebrow">FAQ</p><h2 class="mt-2">{svc.name} questions</h2></div>
      <div class="lg:col-span-8"><FaqList faqs={svc.faqs} /></div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <h2 class="text-2xl">Other mailbox services</h2>
      <div class="mt-6 flex flex-wrap gap-3">{others.map((o) => <a class="rounded-xl border border-slate-200 bg-white px-5 py-3 font-display text-base font-bold text-navy-950 shadow-xs transition hover:border-blue-700 hover:text-blue-700" href={`/services/${o.slug}/`}>{o.name}</a>)}</div>
    </div>
  </section>
  <CtaBand />
</Base>
