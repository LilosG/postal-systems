---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { AREAS, SITE } from '../../data/site';
const crumbs = [{ name: 'Service Areas' }];
---
<Base title="Mailbox Installation Service Areas | San Diego County & Beyond" description="Postal Systems installs and repairs commercial mailboxes across San Diego County, with select projects in Riverside and Orange Counties." crumbs={crumbs}>
  <PageHero kicker="Service areas" title="Serving San Diego County and Southern California" text={`Based in ${SITE.base}. We serve San Diego County and take select projects in Riverside and Orange Counties.`} crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {AREAS.map((a) => (
        <a href={`/service-areas/${a.slug}/`} class="card group flex items-center justify-between !p-6">
          <div>
            <h2 class="text-xl group-hover:text-blue-700">{a.name}</h2>
            <p class="mt-1 text-sm text-slate-500">{a.type === 'county' ? 'Select projects' : a.region}</p>
          </div>
          <span class="icon-chip group-hover:bg-blue-700 group-hover:text-white"><Icon name="arrow" class="h-4 w-4" /></span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
