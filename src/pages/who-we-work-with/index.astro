---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { AUDIENCES, getService } from '../../data/site';
const crumbs = [{ name: 'Who We Work With' }];
---
<Base title="Mailbox Installation for HOAs, Apartments & Builders | Postal Systems" description="Postal Systems works with HOAs, property managers, apartment communities, builders, commercial parks and municipal campuses across San Diego County." crumbs={crumbs}>
  <PageHero kicker="Who we work with" title="Built for property professionals" text="Turnkey mailbox installs with USPS coordination for the people who manage and build properties." crumbs={crumbs} />
  <section class="section">
    <div class="container-x space-y-6">
      {AUDIENCES.map((a) => (
        <article class="grid gap-6 border border-blue-100 p-8 md:grid-cols-12">
          <div class="md:col-span-7"><h2 class="text-3xl">{a.name}</h2><p class="mt-3 text-lg text-slate-600">{a.text}</p></div>
          <ul class="space-y-2 md:col-span-5">
            {a.services.map((s) => { const sv = getService(s); return <li><a class="font-display text-xl font-semibold text-navy-900 hover:text-red-600" href={`/services/${sv.slug}/`}>{sv.name} &rarr;</a></li>; })}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
