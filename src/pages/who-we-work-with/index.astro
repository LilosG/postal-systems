---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { AUDIENCES, getService } from '../../data/site';
const crumbs = [{ name: 'Who We Work With' }];
---
<Base title="Mailbox Installation for HOAs, Apartments & Builders | Postal Systems" description="Postal Systems works with HOAs, property managers, apartment communities, builders, commercial parks and municipal campuses across San Diego County." crumbs={crumbs}>
  <PageHero kicker="Who we work with" title="Built for property professionals" text="Turnkey mailbox installs with USPS coordination for the people who manage and build properties." crumbs={crumbs} />
  <section class="section">
    <div class="container-x space-y-6">
      {AUDIENCES.map((a) => (
        <article class="card grid items-center gap-8 md:grid-cols-12">
          <div class="md:col-span-7"><h2 class="text-2xl">{a.name}</h2><p class="mt-3 text-base leading-relaxed text-slate-600">{a.text}</p></div>
          <ul class="space-y-3 md:col-span-5">
            {a.services.map((s) => { const sv = getService(s); return <li><a class="flex items-center justify-between rounded-xl border border-slate-100 bg-slate-50/80 px-4 py-3 font-display text-base font-bold text-navy-950 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700" href={`/services/${sv.slug}/`}><span>{sv.name}</span><Icon name="arrow" class="h-4 w-4 text-red-600" /></a></li>; })}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
