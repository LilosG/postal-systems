---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EstimateForm from '../components/EstimateForm.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Contact' }];
---
<Base title="Get a Mailbox Installation Estimate | Postal Systems San Diego" description="Request a fast estimate for USPS-approved mailbox installation, repair or lock changes. Call (619) 461-4787 or send a short form." crumbs={crumbs}>
  <PageHero kicker="Contact" title="Get your estimate" text="Tell us what you need in a few seconds. We reply quickly with next steps." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="card">
          <h2 class="text-2xl">Request an estimate</h2>
          <p class="mb-6 mt-2 text-slate-500">Name, phone and what you need. That's it.</p>
          <EstimateForm id="contact" />
        </div>
      </div>
      <aside class="space-y-6 lg:col-span-5">
        <div class="navy-bg rounded-2xl p-8 text-white shadow-xl">
          <p class="text-xs font-bold uppercase tracking-wider text-blue-200">Direct Line</p>
          <h2 class="mt-2 !text-white text-2xl">Prefer to talk?</h2>
          <a href={SITE.phoneHref} class="mt-5 flex items-center gap-3 font-display text-3xl font-bold text-white transition hover:text-red-400">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-white/10"><Icon name="phone" class="h-5 w-5 text-red-400" /></span>
            {SITE.phone}
          </a>
          <a href={`mailto:${SITE.email}`} class="mt-4 flex items-center gap-3 text-base text-blue-100/80 transition hover:text-white">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-white/10"><Icon name="mail" class="h-5 w-5 text-blue-200" /></span>
            {SITE.email}
          </a>
        </div>
        <div class="card">
          <h3 class="text-xl">Service area</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">Based in {SITE.base}. Serving San Diego County, with select projects in Riverside and Orange Counties.</p>
          <p class="mt-4 inline-flex items-center gap-2 rounded-lg bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700">California Contractor License #{SITE.license}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
