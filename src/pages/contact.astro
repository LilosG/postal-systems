---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Contact' }];
---
<Base title="Get a Mailbox Installation Estimate | Postal Systems San Diego" description="Request a fast estimate for USPS-approved mailbox installation, repair or lock changes. Call (619) 461-4787 or send a short form." crumbs={crumbs}>
  <PageHero kicker="Contact" title="Get your estimate" text="Tell us what you need in a few seconds. We reply quickly with next steps." crumbs={crumbs} />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="relative border border-blue-100 p-8">
          <div class="stripe absolute inset-x-0 top-0 h-[6px]"></div>
          <h2 class="text-3xl">Request an estimate</h2>
          <p class="mb-6 mt-2 text-slate-600">Name, phone and what you need. That's it.</p>
          <EstimateForm id="contact" />
        </div>
      </div>
      <aside class="space-y-6 lg:col-span-5">
        <div class="bg-navy-900 p-8 text-white">
          <h2 class="!text-white text-3xl">Prefer to talk?</h2>
          <a href={SITE.phoneHref} class="mt-4 block font-display text-5xl font-bold hover:text-red-500">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} class="mt-3 block text-lg text-white/80 hover:text-white">{SITE.email}</a>
        </div>
        <div class="border border-blue-100 p-8">
          <h3>Service area</h3>
          <p class="mt-2 text-slate-600">Based in {SITE.base}. Serving San Diego County, with select projects in Riverside and Orange Counties.</p>
          <p class="mt-4 text-sm text-slate-500">California Contractor License #{SITE.license}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
