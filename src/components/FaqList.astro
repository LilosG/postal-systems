---
const { faqs } = Astro.props;
---
<div class="divide-y divide-blue-100 border-y border-blue-100">
  {faqs.map((f: { q: string; a: string }) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl font-semibold text-navy-950 sm:text-2xl">
        {f.q}
        <span class="grid h-8 w-8 shrink-0 place-items-center bg-blue-50 text-xl text-red-600 transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-slate-600">{f.a}</p>
    </details>
  ))}
</div>
