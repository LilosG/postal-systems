---
const { faqs } = Astro.props;
---
<div class="divide-y divide-slate-200/80 rounded-2xl border border-slate-200/80 bg-white px-6 sm:px-8 shadow-sm">
  {faqs.map((f: { q: string; a: string }) => (
    <details class="group py-6">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold text-navy-950 sm:text-xl">
        {f.q}
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-blue-50 text-lg font-bold text-blue-700 transition group-open:rotate-45 group-open:bg-red-50 group-open:text-red-600">+</span>
      </summary>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600">{f.a}</p>
    </details>
  ))}
</div>
