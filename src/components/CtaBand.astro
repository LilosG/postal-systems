---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
const { title = 'Get an estimate from an expert, fast', text = 'The right USPS-approved mailboxes, proper installation and postal coordination, all on the first try and for one price.' } = Astro.props;
---
<section class="container-x py-16">
  <div class="hero-bg relative isolate overflow-hidden rounded-3xl px-8 py-14 text-white shadow-2xl shadow-navy-900/30 sm:px-14">
    <div class="door-grid absolute inset-0 -z-10 opacity-70 [mask-image:linear-gradient(to_left,black,transparent_80%)]"></div>
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
      <div>
        <h2 class="!text-white">{title}</h2>
        <p class="mt-3 max-w-2xl text-lg text-white/75">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn btn-red shadow-lg shadow-red-600/30">Get an estimate</a>
        <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="phone" class="h-4 w-4" />{SITE.phone}</a>
      </div>
    </div>
  </div>
</section>
