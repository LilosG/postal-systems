---
import { SITE } from '../data/site';
const { title = 'Get an estimate from an expert, fast', text = 'The right USPS-approved mailboxes, proper installation and postal coordination, all on the first try and for one price.' } = Astro.props;
---
<section class="bg-navy-900 text-white">
  <div class="container-x grid items-center gap-8 py-16 lg:grid-cols-[1fr_auto]">
    <div>
      <h2 class="!text-white">{title}</h2>
      <p class="mt-3 max-w-2xl text-lg text-white/70">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/contact/" class="btn btn-red">Get an estimate</a>
      <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
    </div>
  </div>
</section>
