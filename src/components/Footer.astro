---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, SERVICES, AREAS } from '../data/site';
---
<footer class="navy-bg border-t border-white/10 text-white">
  <div class="container-x grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <a href="/" aria-label="Postal Systems home"><Logo light /></a>
      <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-blue-100/75">USPS-approved commercial and residential mailbox supply, installation and repair, based in {SITE.base}.</p>
      <div class="mt-6 inline-flex items-center gap-2.5 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-xs font-semibold text-blue-100">
        <Icon name="shield" class="h-4 w-4 text-red-500" />
        <span>USPS-Approved Vendor &bull; CA Lic #{SITE.license}</span>
      </div>
      <div class="mt-6 space-y-1.5">
        <p><a href={SITE.phoneHref} class="font-display text-2xl font-bold text-white transition hover:text-red-400">{SITE.phone}</a></p>
        <p><a href={`mailto:${SITE.email}`} class="text-sm text-blue-200/75 transition hover:text-white">{SITE.email}</a></p>
      </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-3 lg:col-span-8">
      <div>
        <h3 class="!text-white text-sm font-bold uppercase tracking-wider">Services</h3>
        <ul class="mt-4 space-y-2.5 text-[0.92rem] text-blue-100/75">
          {SERVICES.map((s) => <li><a class="transition hover:text-white" href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="!text-white text-sm font-bold uppercase tracking-wider">Service Areas</h3>
        <ul class="mt-4 space-y-2.5 text-[0.92rem] text-blue-100/75">
          {AREAS.slice(0, 7).map((a) => <li><a class="transition hover:text-white" href={`/service-areas/${a.slug}/`}>{a.name}</a></li>)}
          <li><a class="font-semibold text-red-400 transition hover:text-red-300" href="/service-areas/">All 13 areas &rarr;</a></li>
        </ul>
      </div>
      <div>
        <h3 class="!text-white text-sm font-bold uppercase tracking-wider">Company</h3>
        <ul class="mt-4 space-y-2.5 text-[0.92rem] text-blue-100/75">
          <li><a class="transition hover:text-white" href="/products/">USPS-Approved Products</a></li>
          <li><a class="transition hover:text-white" href="/who-we-work-with/">Who We Serve</a></li>
          <li><a class="transition hover:text-white" href="/projects/">Recent Projects</a></li>
          <li><a class="transition hover:text-white" href="/about/">About Postal Systems</a></li>
          <li><a class="transition hover:text-white" href="/contact/">Request an Estimate</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-blue-200/60 sm:flex-row sm:justify-between">
      <p>&copy; {new Date().getFullYear()} Postal Systems. All rights reserved. <a class="underline hover:text-white" href="/privacy/">Privacy Policy</a></p>
      <p>Website design by <a class="underline hover:text-white" href={SITE.designer.url}>{SITE.designer.name}</a></p>
    </div>
  </div>
</footer>
