---
const { light = false } = Astro.props;
---
<span class="inline-flex items-center gap-3.5">
  <svg viewBox="0 0 40 44" class="h-10 w-9 shrink-0" aria-hidden="true">
    <rect x="2" y="3" width="36" height="38" rx="4" fill={light ? '#ffffff' : '#004B87'} />
    <g fill={light ? '#004B87' : '#ffffff'}>
      <rect x="6" y="7" width="12" height="7" rx="1" /><rect x="22" y="7" width="12" height="7" rx="1" />
      <rect x="6" y="17" width="12" height="7" rx="1" /><rect x="22" y="17" width="12" height="7" rx="1" />
      <rect x="6" y="27" width="12" height="10" rx="1" />
    </g>
    <rect x="22" y="27" width="12" height="10" rx="1" fill="#DA291C" />
  </svg>
  <span class="leading-none">
    <span class:list={['block font-display text-[1.35rem] font-bold tracking-tight', light ? 'text-white' : 'text-navy-950']}>Postal Systems</span>
    <span class:list={['mt-1 block whitespace-nowrap text-[0.62rem] font-semibold uppercase tracking-[0.18em]', light ? 'text-blue-200/70' : 'text-slate-500']}>Supply &bull; Installation &bull; Repair</span>
  </span>
</span>
