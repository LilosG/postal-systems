---
import { SITE } from '../data/site';
const { kicker, title, text, image, imageAlt = '', crumbs = [] } = Astro.props;
---
<section class="bg-navy-900 text-white">
  <div class="container-x grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-12">
    <div class:list={[image ? 'lg:col-span-7' : 'lg:col-span-9']}>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/60">
          {crumbs.map((c: { name: string; href?: string }, i: number) => (
            <span>{i > 0 && <span class="mx-2">/</span>}{c.href ? <a class="hover:text-white" href={c.href}>{c.name}</a> : <span class="text-white/90">{c.name}</span>}</span>
          ))}
        </nav>
      )}
      {kicker && <p class="eyebrow !text-white/60 mb-4">{kicker}</p>}
      <h1 class="!text-white">{title}</h1>
      {text && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">{text}</p>}
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn btn-red">Get an estimate</a>
        <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
      </div>
    </div>
    {image && (
      <div class="lg:col-span-5">
        <img src={image} alt={imageAlt} width="1200" height="1200" loading="eager" class="aspect-[4/3] w-full rounded-2xl object-cover shadow-2xl shadow-black/30" />
      </div>
    )}
  </div>
</section>
