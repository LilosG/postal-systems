---
import { SITE } from '../data/site';
const { kicker, title, text, image, imageAlt = '', crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_10%,rgba(52,71,168,.7),transparent_55%)]"></div>
  <div class="container-x relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-12">
    <div class:list={[image ? 'lg:col-span-7' : 'lg:col-span-9']}>
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-5 text-sm text-white/70">
          {crumbs.map((c: { name: string; href?: string }, i: number) => (
            <span>{i > 0 && <span class="mx-2">/</span>}{c.href ? <a class="hover:text-white" href={c.href}>{c.name}</a> : <span class="text-white">{c.name}</span>}</span>
          ))}
        </nav>
      )}
      {kicker && <p class="eyebrow !text-red-500 mb-3">{kicker}</p>}
      <h1 class="!text-white">{title}</h1>
      {text && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">{text}</p>}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn btn-red">Get an Estimate</a>
        <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
      </div>
    </div>
    {image && (
      <div class="relative lg:col-span-5">
        <div class="absolute -bottom-3 -left-3 h-full w-full border-2 border-red-600"></div>
        <img src={image} alt={imageAlt} width="1200" height="1200" loading="eager" class="relative aspect-[4/3] w-full object-cover" />
      </div>
    )}
  </div>
  <div class="stripe h-[6px]"></div>
</section>
